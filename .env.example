# ⚠️ IMPORTANT: Copy this file to `.env` and fill in values.
# Never commit `.env` — it contains secrets.
#     cp .env.example .env
#
# ⚠️ Use ABSOLUTE paths for PROJECT_PARENT_PATH and PROJECT_PATH.
# Relative paths break Docker volume mounts across machines.

# Identity & Paths
PROJECT_NAME=model_md
PROJECT_PARENT_PATH=/absolute/path/to/parent_workspace
PROJECT_PATH=/absolute/path/to/parent_workspace/model_md
LOCAL_DOCKER_DESKTOP_CATALOG=/absolute/path/to/parent_workspace/.docker/mcp
# Absolute path to the user's home directory. Compose uses this instead of
# '~' for agent config volumes so 'sudo task ...' does not resolve to /root.
HOST_HOME=/home/your_user

# Host UID/GID — propagated into containers so files owned by your user,
# not root. Auto-detected by Taskfile; override only if needed.
HOST_UID=1000
HOST_GID=1000
# Docker socket path for rootless (Omarchy) vs rootful setups.
# Auto-detected by Taskfile; override only if needed.
# Examples:
#   rootless: /run/user/1000/docker.sock
#   rootful:  /var/run/docker.sock
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# GID of the host 'docker' group (rootful daemons). Auto-detected by Taskfile.
# DOCKER_GROUP_GID=999

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Connection Strings
# Fill in project name for Taskfile env due to not interpolating environment variables
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@supabase_db_${PROJECT_NAME}:5432/postgres
TASKFILE_DATABASE_URL=postgresql://postgres:postgres@supabase_db_(FILL IN PROJECT NAME HERE):5432/postgres
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
TEST_USER_ID={VALUE_GENERATED_BY_SUPABASE_AUTH_USERS_TABLE}

SUPABASE_URL=http://supabase_kong_${PROJECT_NAME}:8000
SUPABASE_ANON_KEY={SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY={SUPABASE_SERVICE_ROLE_KEY}
VITE_SUPABASE_URL=http://localhost:54321

S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
S3_ACCESS_KEY_ID={S3_ACCESS_KEY_ID}
S3_SECRET_ACCESS_KEY={S3_SECRET_ACCESS_KEY}
S3_REGION=local

# MCP catalog root. MUST be an ABSOLUTE path inside the parent workspace
# (e.g. alongside where git worktrees live), never '~'-based: under sudo
# '~' resolves to /root and scatters root-owned catalogs. Tasks pass this
# to mcp-gateway via DOCKER_MCP_ROOT (tasks/mcp.yml) and compose mounts it.
LOCAL_MCP_REGISTRY=/absolute/path/to/parent_workspace/.docker/mcp
# mcp-gateway v0.43.1+ requires Bearer auth on SSE by default (CVE
# GHSA-g879-4j4f-6vj7). Set a shared token here; opencode/pi/antigravity
# send it as `Authorization: Bearer <token>`. Generate: openssl rand -hex 32
MCP_GATEWAY_AUTH_TOKEN=change-me-64-hex-chars
GEMINI_API_KEY={VALUE}

