version: 3
name: local-mcp
displayName: Local Development Catalog
registry:
  ast-explorer:
    title: "My Custom Python MCP"
    description: "Personal tools for OpenCode integration"
    type: server
    dateAdded: "2026-02-20T17:55:00Z"
    image: ast-explorer:latest
    metadata:
      category: utility
      tags:
        - local
        - python
    volumes:
      - ${PROJECT_PARENT_PATH}:/app:ro
    env:
      - name: PYTHONUNBUFFERED
        value: "1"
      - name: REDIS_HOST
        value: "cache"
      - name: WORKSPACE_ROOT
        value: "/app"
      - name: DEFAULT_PROJECT
        value: "${PROJECT_NAME}"
      - name: DOCKER_MCP_TRANSPORT
        value: "stdio"
      - name: DOCKER_HOST
        value: "tcp://mcp-socket-proxy:2375"
    tools:
      - name: scan_specific_file
        description: "Deep scan a single file to refresh its AST cache or get detailed signatures. Use when precision is needed for one file."
      - name: get_repo_map
        description: "Generates a high-level overview of a directory's structure, classes, and functions. Best for initial project exploration."
      - name: find_symbol
        description: "Search for a symbol name (class/function) across indexed files. Optionally filter by project/folder."
      - name: get_dependents
        description: "Lists all files that import the target file. Essential for understanding dependencies and the impact of code changes."

  supabase-manager:
    title: "Supabase DB Manager"
    description: "MCP for managing Supabase users and stats via Drizzle"
    type: server
    dateAdded: "2026-03-04T13:00:00Z"
    image: supabase-manager:latest
    metadata:
      category: database
      tags:
        - typescript
        - postgres
        - supabase
    networks:
      - supabase_network
    env:
      - name: DATABASE_URL
        value: ${TASKFILE_DATABASE_URL}
      - name: DOCKER_MCP_TRANSPORT
        value: "stdio"
      - name: DOCKER_HOST
        value: "tcp://mcp-socket-proxy:2375"
    tools:
      - name: get_user_stats
        description: "Returns the total count of users and recent signups from the database."

  portfolio-orchestrator:
    title: "Portfolio Round Orchestrator"
    description: "MCP for launching analyst rounds: checks dataset readiness, spawns persona subagents via docker exec opencode run, monitors round jobs, and delivers the round envelope to the backend run API"
    type: server
    dateAdded: "2026-09-25T00:00:00Z"
    image: portfolio-orchestrator:latest
    metadata:
      category: portfolio
      tags:
        - typescript
        - mcp
        - portfolio
    networks:
      # Must reach BOTH: supabase_network → the feature backend container
      # (feat-portfolio-sim-backend:3000) AND dev-network → mcp-socket-proxy
      # (spawned-server's DOCKER_HOST for `docker exec opencode_agent`).
      - supabase_network
      - dev-network
    env:
      - name: PORTFOLIO_BACKEND_URL
        value: "http://feat-portfolio-sim-backend:3000"
      - name: WORKTREE_SLUG
        value: "model_md-worktree-feat-portfolio-sim"
      - name: AGENT_CONTAINER
        value: "opencode_agent"
      - name: DOCKER_MCP_TRANSPORT
        value: "stdio"
      - name: DOCKER_HOST
        value: "tcp://mcp-socket-proxy:2375"
      - name: MAX_PARALLEL
        value: "3"
      - name: INITIAL_CAPITAL
        value: "100000"
      - name: AGENT_TIMEOUT_MS
        value: "600000"
    tools:
      - name: round_dataset_status
        description: "Queries the backend for the current round dataset (asOfTradeDate, universe, dataReady)."
      - name: create_simulation
        description: "Creates the carryover simulation that a chain of rounds folds into. Required before start_agent_round with a simulationId; idempotent on an existing handle."
      - name: start_agent_round
        description: "Reads the round dataset, spawns analyst subagents, collects their envelopes, and inserts them into the backend run API."
      - name: get_round_status
        description: "Returns the current job status of a running round, including per-agent progress and inserted run ids."

  git-orchestrator:
    title: "Git Worktree Orchestrator"
    description: "Atomic management of isolated feature environments and git worktrees"
    type: server
    image: git-orchestrator:latest
    allowedPaths:
      - "${PROJECT_PARENT_PATH}"
      - "/app/"
    volumes:
      # Whole workspace is READ-ONLY: the spawned server may only write into
      # the worktrees bind (feature code) and the main repo's .git (git_ops
      # commits / worktree metadata). The /opt/orchestrator overlay keeps the
      # container running live repo source without a rebuild, but is ro so a
      # compromised server cannot tamper with orchestrator code in the main
      # repo.
      - ${PROJECT_PARENT_PATH}:/app:ro
      - ${PROJECT_PARENT_PATH}/worktrees:/app/worktrees
      - ${PROJECT_PARENT_PATH}/${PROJECT_NAME}/.git:/app/${PROJECT_NAME}/.git
      - ${PROJECT_PATH}/apps/mcp-servers/mcp-git-orchestrator/:/opt/orchestrator:ro
    env:
      - name: REDIS_HOST
        value: "cache"
      - name: REDIS_PORT
        value: "6379"
      - name: PYTHONUNBUFFERED
        value: "1"
      - name: WORKSPACE_ROOT
        value: "/app"
      - name: PROJECT_PARENT_PATH
        value: "${PROJECT_PARENT_PATH}"
      - name: PROJECT_NAME
        value: "${PROJECT_NAME}"
      - name: USER_ID
        value: "${HOST_UID}"
      - name: GROUP_ID
        value: "${HOST_GID}"
      - name: DBOS_SYSTEM_DATABASE_URL
        value: ${TASKFILE_DATABASE_URL}
      - name: DOCKER_HOST
        value: "tcp://mcp-socket-proxy:2375"
    tools:
      - name: initialize_worktree
        description: "Creates a new git worktree, allocates ports, and starts the feature Docker environment."
      - name: get_job_status
        description: "Checks the status of a background task using a job_id. Required for checking if initialize_worktree is finished."
      - name: execute_lifecycle
        description: "Executes a container-based lifecycle action: 'initialize' (db reset/seed), 'generate' (drizzle/codegen), 'migrate', 'seed', 'verify' (tests/lint), or 'build'."
      - name: get_environment_logs
        description: "Retrieves the last 'n' lines of logs for a feature's containers. If 'service' is provided (e.g., 'backend', 'db'), only those logs are returned."
      - name: git_ops
        description: "Executes safe Git commands (add, commit, status, diff, log, branch, merge)."
      - name: get_environment_status
        description: "Returns the status of all containers for a given feature branch."
      - name: list_features
        description: "Lists all active feature worktrees."
      - name: stop_environment
        description: "Tears down the docker-compose environment and cleans up volumes."
